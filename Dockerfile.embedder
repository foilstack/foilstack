FROM python:3.12-slim

WORKDIR /app
ENV PYTHONUNBUFFERED=1 PYTHONPATH=/app/src

# torch is the bulk of this image. CPU wheels by default so the stack comes up
# on a laptop; override the index for CUDA if you have a GPU.
#
# torchvision is not optional: AutoImageProcessor refuses to build without it,
# and the failure arrives at model-load time rather than at install time.
RUN pip install --no-cache-dir \
    "fastapi>=0.115" "uvicorn[standard]>=0.30" "pydantic>=2.7" "pillow>=10.0" \
    "transformers>=4.44" \
    && pip install --no-cache-dir torch torchvision --index-url https://download.pytorch.org/whl/cpu

COPY src/foilstack/embedder /app/src/foilstack/embedder
COPY src/foilstack/__init__.py /app/src/foilstack/__init__.py

EXPOSE 8100
CMD ["uvicorn", "foilstack.embedder.app:app", "--host", "0.0.0.0", "--port", "8100"]
